{
  "name": "@salesforce/templates",
  "version": "66.17.2",
  "packageManager": "pnpm@12.8.2",
  "description": "Salesforce JS library for templates",
  "bugs": "https://github.com/forcedotcom/salesforcedx-templates/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-templates.git"
  },
  "main": "lib/index.js",
  "author": "Salesforce",
  "homepage": "https://github.com/forcedotcom/salesforcedx-templates",
  "license": "BSD-3-Clause",
  "files": [
    "/lib",
    "/messages"
  ],
  "dependencies": {
    "@salesforce/kit": "^4.0.0",
    "ejs": "^3.1.10",
    "got": "^11.8.6",
    "hpagent": "^1.2.0",
    "mime-types": "^3.0.2",
    "proxy-from-env": "^1.1.0",
    "tar": "^7.5.22",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@salesforce/dev-config": "^4.3.3",
    "@salesforce/dev-scripts": "^14.0.0",
    "@salesforce/prettier-config": "^0.0.4",
    "@salesforce/ui-bundle-template-app-angular-template-b2e": "^12.4.4",
    "@salesforce/ui-bundle-template-app-angular-template-b2x": "^12.12.0",
    "@salesforce/ui-bundle-template-app-react-template-b2e": "^12.9.0",
    "@salesforce/ui-bundle-template-app-react-template-b2x": "^12.9.0",
    "@salesforce/ui-bundle-template-base-angular-app": "^12.4.4",
    "@salesforce/ui-bundle-template-base-react-app": "^12.9.0",
    "@salesforce/ui-bundle-template-base-vue-app": "^12.11.0",
    "@salesforce/ui-bundle-template-base-web-app": "^12.9.0",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/chai": "^4.3.17",
    "@types/chai-as-promised": "^7.1.8",
    "@types/ejs": "^3.1.5",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/proxy-from-env": "^1.0.4",
    "@types/sinon": "^10.0.20",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-salesforce": "^2.2.2",
    "eslint-config-salesforce-license": "^1.0.2",
    "eslint-config-salesforce-typescript": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "nyc": "^15.1.0",
    "prettier": "^2.0.5",
    "pretty-quick": "^3.3.1",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
    "sinon": "^18",
    "ts-morph": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0",
    "wireit": "^0.14.13"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wireit",
    "build:templates": "wireit",
    "build:copy-templates": "wireit",
    "clean:lib": "shx rm -rf lib && shx rm -rf coverage && shx rm -rf .nyc_output",
    "commit": "git-cz",
    "compile": "wireit",
    "lint": "wireit",
    "lint:fix": "eslint --config eslint.config.mjs --no-config-lookup ./src ./test --fix",
    "precommit": "wireit",
    "prepush": "wireit",
    "test": "wireit",
    "test:ai-auto": "node --test test/ai-auto-approve.test.mjs",
    "prepare": "husky"
  },
  "wireit": {
    "precommit": {
      "dependencies": [
        "precommit:scan-ts"
      ]
    },
    "precommit:lint": {
      "command": "pnpm lint",
      "files": [
        "src/**/*",
        "!src/templates/uiBundles",
        "!src/templates/project/reactinternalapp",
        "!src/templates/project/reactexternalapp",
        "!src/templates/project/angularintapp",
        "!src/templates/project/angularextapp",
        "test/**/*",
        "eslint.config.mjs",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "output": []
    },
    "precommit:format": {
      "#comment": "Always run because Wireit cannot fingerprint Git's staged index.",
      "command": "pnpm exec pretty-quick --staged",
      "dependencies": [
        "precommit:lint"
      ]
    },
    "precommit:scan-ts": {
      "command": "node ./scripts/scanTs.js",
      "dependencies": [
        "precommit:format"
      ],
      "files": [
        "scripts/scanTs.js",
        "src/**/*.ts",
        "tsconfig.json",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "output": []
    },
    "prepush": {
      "dependencies": [
        "prepush:verify-bundling"
      ]
    },
    "prepush:build": {
      "command": "pnpm build",
      "files": [
        "src/**/*",
        "!src/templates/uiBundles",
        "!src/templates/project/reactinternalapp",
        "!src/templates/project/reactexternalapp",
        "!src/templates/project/angularintapp",
        "!src/templates/project/angularextapp",
        "scripts/**/*",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json"
      ],
      "output": [
        "lib/**/*",
        "src/templates/uiBundles/**",
        "src/templates/project/reactinternalapp/**",
        "src/templates/project/reactexternalapp/**",
        "src/templates/project/angularintapp/**",
        "src/templates/project/angularextapp/**"
      ]
    },
    "prepush:test": {
      "command": "pnpm test",
      "dependencies": [
        "prepush:build"
      ],
      "files": [
        "src/**/*",
        "test/**/*",
        "scripts/**/*",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.json"
      ],
      "output": []
    },
    "prepush:verify-bundling": {
      "command": "node scripts/verify-for-bundling.js",
      "dependencies": [
        "prepush:test"
      ],
      "files": [
        "scripts/verify-for-bundling.js",
        "src/templates/**/*",
        "lib/templates/**/*"
      ],
      "output": []
    },
    "build": {
      "dependencies": [
        "compile",
        "build:copy-templates",
        "build:templates"
      ]
    },
    "compile": {
      "command": "tsc --build --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "src/**/*.json",
        "!src/templates/**",
        "tsconfig*.json"
      ],
      "output": [
        "lib/**",
        "!lib/templates",
        "tsconfig.tsbuildinfo"
      ]
    },
    "build:copy-templates": {
      "command": "node scripts/copy-templates",
      "dependencies": [
        "compile"
      ],
      "files": [
        "scripts/copy-templates.js"
      ],
      "output": [
        "src/templates/uiBundles/**",
        "src/templates/project/reactinternalapp/**",
        "src/templates/project/reactexternalapp/**",
        "src/templates/project/angularintapp/**",
        "src/templates/project/angularextapp/**"
      ]
    },
    "build:templates": {
      "command": "node scripts/build-templates",
      "dependencies": [
        "build:copy-templates"
      ],
      "files": [
        "scripts/build-templates.js",
        "src/templates/**"
      ],
      "output": [
        "lib/templates"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache --config eslint.config.mjs --no-config-lookup ./src ./test",
      "files": [
        "src/**",
        "test/**",
        "eslint.config.mjs",
        ".prettierrc",
        "tsconfig*.json"
      ],
      "output": []
    },
    "test": {
      "command": "nyc --exclude src/i18n/localization.ts --extension .ts mocha --parallel --forbid-only \"test/**/*.test.ts\" --timeout 600000",
      "dependencies": [
        "build"
      ],
      "files": [
        "test/**",
        "scripts/**",
        ".mocharc.json",
        ".nycrc"
      ],
      "output": [
        "coverage/**",
        ".nyc_output/**"
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
