{
  "name": "@salesforce/templates",
  "version": "66.13.9",
  "description": "Salesforce JS library for templates",
  "bugs": "https://github.com/forcedotcom/salesforcedx-templates/issues",
  "main": "lib/index.js",
  "author": "Salesforce",
  "homepage": "https://github.com/forcedotcom/salesforcedx-templates",
  "license": "BSD-3-Clause",
  "files": [
    "/lib",
    "/messages"
  ],
  "dependencies": {
    "@salesforce/kit": "^4.0.0",
    "ejs": "^3.1.10",
    "got": "^11.8.6",
    "hpagent": "^1.2.0",
    "mime-types": "^3.0.2",
    "proxy-from-env": "^1.1.0",
    "tar": "^7.5.22",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@salesforce/dev-config": "^4.3.3",
    "@salesforce/dev-scripts": "^14.0.0",
    "@salesforce/prettier-config": "^0.0.4",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@salesforce/ui-bundle-template-app-angular-template-b2e": "^11.71.5",
    "@salesforce/ui-bundle-template-app-angular-template-b2x": "^11.62.1",
    "@salesforce/ui-bundle-template-app-react-template-b2e": "^11.57.2",
    "@salesforce/ui-bundle-template-app-react-template-b2x": "^11.64.0",
    "@salesforce/ui-bundle-template-base-angular-app": "^11.62.1",
    "@salesforce/ui-bundle-template-base-react-app": "^11.64.0",
    "@salesforce/ui-bundle-template-base-web-app": "^11.64.0",
    "@types/chai-as-promised": "^7.1.8",
    "@types/ejs": "^3.1.5",
    "@types/mime-types": "^3.0.1",
    "@types/proxy-from-env": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-salesforce": "^2.2.1",
    "eslint-config-salesforce-license": "^1.0.2",
    "eslint-config-salesforce-typescript": "^7.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.3",
    "mocha": "^11.8.0",
    "nyc": "^15.1.0",
    "prettier": "^2.0.5",
    "pretty-quick": "^3.3.1",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
    "sinon": "^18",
    "ts-morph": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "yarn run clean:lib && yarn compile && yarn build:copy-templates && yarn build:templates",
    "build:templates": "node scripts/build-templates",
    "build:copy-templates": "node scripts/copy-templates",
    "clean:lib": "shx rm -rf lib && shx rm -rf coverage && shx rm -rf .nyc_output",
    "commit": "git-cz",
    "compile": "tsc -b",
    "lint": "eslint --config eslint.config.mjs --no-config-lookup ./src ./test",
    "lint:fix": "eslint --config eslint.config.mjs --no-config-lookup ./src ./test --fix",
    "test": "nyc --exclude src/i18n/localization.ts --extension .ts mocha --parallel --forbid-only \"test/**/*.test.ts\" --timeout 600000",
    "prepare": "husky install"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
